{
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "pnpm --filter @voxelio/* run build",
        "build:watch": "pnpm -r run build:watch",
        "biome:format": "biome format --write ./packages",
        "biome:check": "biome check ./packages",
        "biome:unsafefix": "biome check --write --unsafe  ./packages",
        "test": "vitest",
        "check": "pnpm -r exec tsc --noEmit",
        "changeset": "node packages/changeset/dist/cli.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.3",
        "@types/node": "^26.6.5",
        "tsdown": "0.23.2",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}