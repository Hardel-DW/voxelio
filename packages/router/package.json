{
	"name": "@voxelio/router",
	"version": "0.2.0",
	"type": "module",
	"description": "File-based, fully inferred router for React and Vite, built on the Navigation API. Extremely lightweight.",
	"keywords": [
		"react",
		"router",
		"vite",
		"vite-plugin",
		"file-based-routing",
		"navigation-api",
		"typescript"
	],
	"scripts": {
		"build": "tsdown",
		"build:watch": "tsdown --watch",
		"test": "vitest",
		"check": "tsc --noEmit",
		"check:types": "tsdown && tsc -p test/types",
		"biome:format": "biome format --write ./src ./test",
		"biome:check": "biome check ./src ./test",
		"biome:unsafefix": "biome check --write --unsafe ./src ./test"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./routes": {
			"types": "./dist/routes.d.mts",
			"import": "./dist/routes.mjs"
		},
		"./vite": {
			"types": "./dist/vite.d.mts",
			"import": "./dist/vite.mjs"
		}
	},
	"bin": {
		"voxelio-router": "dist/cli.mjs"
	},
	"files": [
		"dist/**/*.mjs",
		"dist/**/*.d.mts",
		"!dist/**/*.map"
	],
	"engines": {
		"node": ">=24"
	},
	"peerDependencies": {
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0",
		"vite": ">=8.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"vite": "^8.3.5"
	},
	"author": {
		"name": "Hardel",
		"email": "teams.voxel@gmail.com",
		"url": "https://voxel.hardel.io"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Hardel-DW/voxelio.git",
		"directory": "packages/router"
	}
}
